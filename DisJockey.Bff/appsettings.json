{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ReverseProxy": {
        "Routes": {
            "angular": {
                "ClusterId": "angularCluster",
                "Match": {
                    "Path": "{**catch-all}"
                }
            }
        },
        "Clusters": {
            "angularCluster": {
                "Destinations": {
                    "angular": {
                        "Address": "http://localhost:4200/"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
